{
  "name": "provider-youtubejs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.2",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "youtubei.js": "18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "//overrides": "Transitive advisories only — every DIRECT dependency is already on its latest release. Each entry is the lowest patched version per major line reported by `pnpm audit`; drop an entry once the parent package ships a fix itself.",
    "overrides": {
      "brace-expansion@^5": "5.0.9",
      "esbuild@~0.28.0": "0.28.2"
    }
  }
}
