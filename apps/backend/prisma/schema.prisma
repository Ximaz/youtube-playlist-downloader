// YPD — OAuth2.0 credential storage (private playlists).
//
// At-rest encryption: this schema stores OAuth access/refresh tokens as plaintext
// columns. See ADR 0008 (docs/decisions/README.md): protection at rest is the database
// volume's responsibility — LUKS / cloud-provider encrypted volume in prod. App-level
// encryption was intentionally NOT added; the project accepts the tradeoff that a
// pg_dump or compromised DB credential reveals raw tokens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Opaque session: the value set in the user's httpOnly cookie. Created for EVERY visitor
// (anonymous, no OAuthAccount) so the realtime WebSocket + batch scoping work without sign-in;
// a Google sign-in adds the OAuthAccount relation. The opaque 122-bit id is the unforgeable
// credential; `userAgent`/`ip` are captured at creation as authenticity/audit signals, and
// `tier` drives the (future) paid/free queueing — everyone is 'paid' for now (no paid flow yet).
model Session {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  tier      String        @default("paid")
  userAgent String?
  ip        String?
  account   OAuthAccount?
}

// Google OAuth2.0 tokens for the YouTube Data API (read-only scope). One per Session.
// `googleSub` is the Google account subject id (stable across sign-ins).
model OAuthAccount {
  sessionId    String   @id
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  googleSub    String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  // OpenID profile captured from the id_token at sign-in (the `profile` scope). Lets the
  // navbar show the real account without a separate Google userinfo call. Nullable so
  // sessions created before the `profile` scope, or accounts with no picture, still work.
  name         String?
  picture      String?
  updatedAt    DateTime @updatedAt

  @@index([googleSub])
}
