# Pinned component versions (single source of truth). See infra/docs/architecture.md.

# Cluster OS + Kubernetes. Pin k8s explicitly: must be <= what TALOS_VERSION supports.
TALOS_VERSION=v1.12.7
TALOS_K8S_VERSION=1.34.1

# Terraform providers (exact versions locked in terraform/.terraform.lock.hcl)
TF_PROXMOX_PROVIDER=">= 0.69.0"
TF_TALOS_PROVIDER=">= 0.7.0"

# Cluster add-ons (installed by bootstrap/helmfile.yaml)
CILIUM_VERSION=1.17.4
CERT_MANAGER_VERSION=v1.16.2
INGRESS_NGINX_VERSION=4.12.0
KEDA_VERSION=2.16.1
LOCAL_PATH_PROVISIONER_VERSION=v0.0.30

# Monitoring add-on: kube-prometheus-stack (Operator + Prometheus + Grafana + node-exporter +
# kube-state-metrics) + blackbox-exporter (turns /health,/ready into probe targets).
KUBE_PROMETHEUS_STACK_VERSION=86.2.3
PROMETHEUS_BLACKBOX_EXPORTER_VERSION=11.12.0
