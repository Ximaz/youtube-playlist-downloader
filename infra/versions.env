# Single source of truth for pinned component versions (ADR-0007: exact pinning).
# Terraform/Helmfile read these; bump here + via Renovate, test on a scratch cluster first.

# Cluster OS + Kubernetes. The provider's default k8s can be too new for the pinned Talos, so pin
# explicitly. Talos 1.12.7 supports Kubernetes up to 1.35; 1.34.1 matches the local kubectl.
TALOS_VERSION=v1.12.7
TALOS_K8S_VERSION=1.34.1

# Terraform providers (exact versions are locked in terraform/.terraform.lock.hcl)
TF_PROXMOX_PROVIDER=">= 0.69.0"
TF_TALOS_PROVIDER=">= 0.7.0"

# Cluster add-ons (installed by bootstrap/helmfile.yaml)
CILIUM_VERSION=1.17.4
CERT_MANAGER_VERSION=v1.16.2
INGRESS_NGINX_VERSION=4.12.0
KEDA_VERSION=2.16.1
LOCAL_PATH_PROVISIONER_VERSION=v0.0.30
