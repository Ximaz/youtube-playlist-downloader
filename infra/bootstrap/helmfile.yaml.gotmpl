# Cluster add-ons (helmfile). Run via `task cluster:addons`; paths are relative to infra/bootstrap/.
# Versions come from versions.env. See infra/docs/architecture.md.

repositories:
  - name: cilium
    url: https://helm.cilium.io
  - name: jetstack
    url: https://charts.jetstack.io
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx
  - name: kedacore
    url: https://kedacore.github.io/charts
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts

helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  createNamespace: true

releases:
  - name: cilium
    namespace: kube-system
    chart: cilium/cilium
    version: {{ requiredEnv "CILIUM_VERSION" | quote }}
    values:
      - cilium/values.yaml
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args: ["apply", "-f", "cilium/lb-pool.yaml"]

  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: {{ requiredEnv "CERT_MANAGER_VERSION" | quote }}
    set:
      - name: crds.enabled
        value: true
    hooks:
      # postsync: issuers need the CRDs + webhook ready.
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args: ["apply", "-f", "cert-manager/issuer.yaml"]

  - name: ingress-nginx
    namespace: ingress-nginx
    chart: ingress-nginx/ingress-nginx
    version: {{ requiredEnv "INGRESS_NGINX_VERSION" | quote }}
    values:
      - ingress-nginx/values.yaml

  - name: keda
    namespace: keda
    chart: kedacore/keda
    version: {{ requiredEnv "KEDA_VERSION" | quote }}

  - name: kube-prometheus-stack
    namespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: {{ requiredEnv "KUBE_PROMETHEUS_STACK_VERSION" | quote }}
    # Helm-3 + helmDefaults wait:true hangs on operator webhooks (same class as cert-manager). The
    # admission webhook is disabled in values; keep wait off and gate readiness via the postsync hook.
    wait: false
    waitForJobs: false
    values:
      - monitoring/kube-prometheus-stack/values.yaml
    hooks:
      # CRDs + operator must be reconciled before `task deploy` ships the app ServiceMonitors/Probes.
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args:
          ["-n", "monitoring", "rollout", "status", "deploy/kube-prometheus-stack-operator", "--timeout=300s"]

  - name: blackbox-exporter
    namespace: monitoring
    chart: prometheus-community/prometheus-blackbox-exporter
    version: {{ requiredEnv "PROMETHEUS_BLACKBOX_EXPORTER_VERSION" | quote }}
    values:
      - monitoring/blackbox/values.yaml
