{
   "panels": [
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "p95 of backend→provider calls (metadata + stream open).",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               },
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(provider_request_duration_seconds_bucket[5m])))",
               "legendFormat": "{{provider}}"
            }
         ],
         "title": "Provider request latency (p95)",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Request throughput per provider and status family.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               },
               "unit": "reqps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 0
         },
         "id": 2,
         "options": {
            "legend": {
               "calcs": [
                  "lastNotNull",
                  "max"
               ],
               "displayMode": "table",
               "placement": "bottom"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (provider, status) (rate(provider_request_duration_seconds_count[5m]))",
               "legendFormat": "{{provider}} / {{status}}"
            }
         ],
         "title": "Provider request rate by status",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "A provider failed and the next was tried (by reason).",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               },
               "unit": "reqps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 8
         },
         "id": 3,
         "options": {
            "legend": {
               "calcs": [
                  "lastNotNull",
                  "max"
               ],
               "displayMode": "table",
               "placement": "bottom"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (from, reason) (rate(provider_fallbacks_total[5m]))",
               "legendFormat": "{{from}} / {{reason}}"
            }
         ],
         "title": "Provider fallbacks / sec",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Provider responses failing Zod validation.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               },
               "unit": "reqps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 8
         },
         "id": 4,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (provider, path) (rate(contract_violations_total[5m]))",
               "legendFormat": "{{provider}} / {{path}}"
            }
         ],
         "title": "Contract violations / sec",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "p95 of S3 operations by type.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               },
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 16
         },
         "id": 5,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.95, sum by (le, op) (rate(s3_op_duration_seconds_bucket[5m])))",
               "legendFormat": "{{op}}"
            }
         ],
         "title": "S3 op latency (p95)",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "S3 operation throughput by type.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               },
               "unit": "reqps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 16
         },
         "id": 6,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (op) (rate(s3_op_duration_seconds_count[5m]))",
               "legendFormat": "{{op}}"
            }
         ],
         "title": "S3 op rate",
         "type": "timeseries"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "ypd"
   ],
   "templating": {
      "list": [
         {
            "label": "Data source",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "browser",
   "title": "YPD / Providers & Storage",
   "uid": "ypd-providers"
}
