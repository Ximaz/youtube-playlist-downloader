{
   "panels": [
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "ypd_readiness_check from /ready: green ok, red failing. min across pods.",
         "fieldConfig": {
            "defaults": {
               "mappings": [
                  {
                     "options": {
                        "0": {
                           "color": "red",
                           "text": "down"
                        },
                        "1": {
                           "color": "green",
                           "text": "up"
                        }
                     },
                     "type": "value"
                  }
               ],
               "thresholds": {
                  "steps": [
                     {
                        "color": "red",
                        "value": null
                     },
                     {
                        "color": "green",
                        "value": 1
                     }
                  ]
               }
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "mergeValues": true,
            "showValue": "never"
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "min by (component, check) (ypd_readiness_check)",
               "legendFormat": "{{component}} / {{check}}"
            }
         ],
         "title": "Per-dependency readiness",
         "type": "state-timeline"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "blackbox probe_success per /health and /ready target URL.",
         "fieldConfig": {
            "defaults": {
               "mappings": [
                  {
                     "options": {
                        "0": {
                           "color": "red",
                           "text": "down"
                        },
                        "1": {
                           "color": "green",
                           "text": "up"
                        }
                     },
                     "type": "value"
                  }
               ],
               "thresholds": {
                  "steps": [
                     {
                        "color": "red",
                        "value": null
                     },
                     {
                        "color": "green",
                        "value": 1
                     }
                  ]
               }
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 0
         },
         "id": 2,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            },
            "mergeValues": true,
            "showValue": "never"
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "probe_success",
               "legendFormat": "{{instance}}"
            }
         ],
         "title": "Health routes up/down",
         "type": "state-timeline"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Latest status per probed route (200 healthy, 503 degraded).",
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 8
         },
         "id": 3,
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "probe_http_status_code",
               "format": "table",
               "instant": true,
               "legendFormat": "{{instance}}"
            }
         ],
         "title": "Health route HTTP status",
         "type": "table"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "blackbox probe round-trip per route.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               },
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 8
         },
         "id": 4,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "probe_duration_seconds",
               "legendFormat": "{{instance}}"
            }
         ],
         "title": "Probe duration",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Ready condition per ypd pod (kube-state-metrics).",
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 16
         },
         "id": 5,
         "options": {
            "colorMode": "value",
            "graphMode": "area",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (pod) (kube_pod_status_ready{namespace=\"ypd\", condition=\"true\"})",
               "legendFormat": "{{pod}}"
            }
         ],
         "title": "Pods ready (ypd)",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Cumulative container restarts per pod — crash-loop early warning.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               }
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 16
         },
         "id": 6,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"ypd\"})",
               "legendFormat": "{{pod}}"
            }
         ],
         "title": "Container restarts (ypd)",
         "type": "timeseries"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "ypd"
   ],
   "templating": {
      "list": [
         {
            "label": "Data source",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "browser",
   "title": "YPD / Health & Readiness",
   "uid": "ypd-health"
}
