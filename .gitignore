# Dependencies
node_modules/
.pnpm-store/

# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# Build output
dist/
build/
*.tsbuildinfo
# Nuxt — `.nuxt/` is the prepared type artifacts (regenerated by `nuxt prepare`,
# which runs via the frontend's postinstall hook). `.output/` is the Nitro build.
.nuxt/
.output/

# Prisma generated client
apps/backend/generated/

# Env / secrets — real env files are ignored; .env.example templates stay tracked.
.env
.env.local
*.local
secrets/**/.env

# Logs
*.log
logs/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local data volumes (if bind-mounted)
.data/
tmp/

CLAUDE.md
.claude/
