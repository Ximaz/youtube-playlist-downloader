{
  "name": "ypd",
  "version": "0.1.0",
  "private": true,
  "description": "YPD — download whole YouTube playlists (providers + NestJS backend + Vue frontend)",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "format:check": "pnpm -r --if-present format:check",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10"
  },
  "lint-staged": {
    "apps/backend/src/**/*.ts": [
      "prettier --write"
    ],
    "apps/frontend/src/**/*.{ts,vue}": [
      "prettier --write"
    ],
    "apps/providers/youtubejs/src/**/*.ts": [
      "prettier --write"
    ],
    "packages/shared/src/**/*.ts": [
      "prettier --write"
    ]
  }
}
