{
  "name": "@ypd/backend-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared NestJS infrastructure (config, cache, storage, jobs, providers, metadata, work-store, metrics) for the YPD backend API and worker images.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/lib-storage": "3.1161.0",
    "@prometheus-io/client": "0.16.1",
    "@ypd/shared": "workspace:*",
    "iovalkey": "0.4.0",
    "p-limit": "7.3.3"
  },
  "peerDependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "bullmq": "6.5.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@types/node": "26.6.6",
    "bullmq": "6.5.3",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
