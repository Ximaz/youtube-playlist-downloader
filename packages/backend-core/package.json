{
  "name": "@ypd/backend-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared NestJS infrastructure (config, cache, storage, jobs, providers, metadata, work-store, metrics) for the YPD backend API and worker images.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1056.0",
    "@aws-sdk/lib-storage": "3.1056.0",
    "@ypd/shared": "workspace:*",
    "iovalkey": "0.3.3",
    "p-limit": "7.1.1",
    "prom-client": "15.1.3"
  },
  "peerDependencies": {
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "bullmq": "5.77.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "@types/node": "24.12.4",
    "bullmq": "5.77.3",
    "eslint": "10.4.0",
    "prettier": "3.8.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vitest": "3.2.4",
    "zod": "4.4.3"
  }
}
