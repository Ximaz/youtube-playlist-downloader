# Backend service env.

# ---- Providers (backend's view: fallback order + internal URLs) ----------------
# Fallback order: backend tries each name left-to-right until one succeeds.
PROVIDER_ORDER=ytdl,youtubejs
PROVIDER_YTDL_URL=http://provider-ytdl:5000
PROVIDER_YOUTUBEJS_URL=http://provider-youtubejs:5001
# Per-request timeout (ms) before falling back to the next provider.
PROVIDER_TIMEOUT_MS=15000

# ---- HTTP ----------------------------------------------------------------------
BACKEND_PORT=3000
# PUBLIC_BASE_URL and FRONTEND_ORIGIN are inert since the BFF migration: the backend is a
# pure token API reached only by the Nuxt server (no CORS, no cookies). Kept for reference.
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:8080

# ---- Worker pools --------------------------------------------------------------
# Downloads are I/O-bound; conversions are ffmpeg (CPU-bound) so keep
# CONVERT_CONCURRENCY near your core count. Both pools run at once for converted/merged.
DOWNLOAD_CONCURRENCY=3
# Defaults to DOWNLOAD_CONCURRENCY when unset.
CONVERT_CONCURRENCY=3

# ---- Caching -------------------------------------------------------------------
# Metadata cache TTL in seconds (default 24h).
METADATA_CACHE_TTL=86400
# Valkey connection (cache + BullMQ queue + OAuth state). Credentials must match the
# 'cache' service in secrets/cache/.env.
CACHE_URL=redis://ypd:ypd-dev-valkey-change-me@cache:6379

# ---- Storage (S3 client) -------------------------------------------------------
# The backend's S3 client. In dev this targets the 'storage' service (SeaweedFS).
# Internal (containers): http://storage:8333 | Host: http://127.0.0.1:8333
# S3_ACCESS_KEY / S3_SECRET_KEY must match AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in
# secrets/storage/.env. Point S3_* at any real provider for production (no code change).
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_BUCKET=ypd
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=ypd-dev-access
S3_SECRET_KEY=ypd-dev-secret-change-me

# ---- Database ------------------------------------------------------------------
# PostgreSQL connection (OAuth token storage). Credentials must match the 'database'
# service in secrets/database/.env.
DATABASE_URL=postgresql://ypd:ypd-dev-pg-change-me@database:5432/ypd?schema=public

# ---- Google OAuth2.0 (YouTube Data API, read-only) -----------------------------
# The OAuth callback now lands on the FRONTEND (the BFF), not the backend. This exact URI
# must be registered in the Google Cloud Console OAuth client's Authorized redirect URIs.
#   dev:  http://localhost:8080/api/auth/google/callback
#   prod: https://frontend.pragmacode.fr/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
