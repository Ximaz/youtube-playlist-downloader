# Storage identity. Dev 'storage' service = SeaweedFS S3 gateway.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are the AWS-standard credential names. SeaweedFS
# provisions a global-admin identity from them (no JSON config file). The backend's S3 client
# uses the SAME credentials as S3_ACCESS_KEY / S3_SECRET_KEY in secrets/backend/.env — keep the
# two pairs in sync.
AWS_ACCESS_KEY_ID=ypd-dev-access
AWS_SECRET_ACCESS_KEY=ypd-dev-secret-change-me
