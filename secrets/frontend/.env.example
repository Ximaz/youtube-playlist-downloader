# Frontend (Nuxt 4 + Backend-for-Frontend) — runtime env, read at container start.
#
# BACKEND_URL is SERVER-ONLY now: only the Nitro BFF calls the backend, and it does so over
# the internal Docker network — the browser never sees this value and never reaches the backend
# directly (it calls the same-origin /api and /socket.io, which Nitro proxies). So point this at
# the INTERNAL service, not a public hostname.
BACKEND_URL=http://backend:3000

# Mark the session cookie `Secure`. Keep `true` in production (HTTPS via nginx). Set `false`
# only for plain-http local dev (e.g. http://localhost:8080), or the cookie won't be stored.
COOKIE_SECURE=true
