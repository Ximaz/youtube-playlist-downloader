# Frontend (Nuxt 4) — runtime env. Read at container start by Nitro and exposed to the
# browser via `useRuntimeConfig().public.backendUrl`. Change the value, restart the
# `frontend` container, refresh the page — no rebuild required.
#
# The URL must be browser-reachable: the browser hits it directly for REST + WebSocket
# (Socket.IO connects to the same origin). When running the full stack on a laptop the
# default `http://localhost:3000` is correct because the backend's port is published on
# `127.0.0.1:3000` by docker-compose. In production point this at the public hostname
# of the backend (e.g. https://api.ypd.example.com).
BACKEND_URL=http://localhost:3000
