# Provider containers (ytdl + youtubejs) — runtime tuning knobs (not secrets).
# PORT is set per-service in docker-compose (5000 / 5001), not here.
LOG_LEVEL=info
# Parallel ranged downloading: split a full download into byte ranges fetched
# concurrently from googlevideo to beat YouTube's per-connection throttle. Keep SIZE
# small (~1 MiB): the throttle ramps up *within* a connection (measured ~70x speedup).
# Set CONCURRENCY=1 to disable.
STREAM_SEGMENT_SIZE=1048576
STREAM_SEGMENT_CONCURRENCY=4
# PO-token provider sidecar (shared by both providers). Tokens are fetched ONLY when YouTube
# demands one (per-video, automatic) — provider-ytdl via its bgutil yt-dlp plugin, provider-
# youtubejs via POST /get_pot then Innertube. Unset ⇒ token escalation no-ops (providers serve
# as today and the backend falls back between them). Points at the `provider-pot` compose service.
POT_PROVIDER_BASE_URL=http://provider-pot:4416
# Per-request timeout (ms) for the youtubejs → POT provider call.
POT_PROVIDER_TIMEOUT_MS=20000
